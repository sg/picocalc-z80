                       1      1 ;	8080 CBIOS for z80pack machines using SD-FDC
                       2      2 ;
                       3      3 ;	Copyright (C) 2024 by Udo Munk
                       4      4 ;
                       5      5 ;	PicoCalc: added a 4 MB hard disk as drive I:. The controller already
                       6      6 ;	carries a 4 bit drive number and byte wide track and sector, so no
                       7      7 ;	new hardware is needed - drive 8 simply has a different geometry,
                       8      8 ;	256 tracks of 128 sectors, and its own disk parameter block.
                       9      9 ;
0040  =               10     10 MSIZE	EQU	64		;CP/M memory size in kilobytes
                      11     11 ;
                      12     12 ;	"bias" is address offset from 3400H for memory systems
                      13     13 ;	than 16K (referred to as "b" throughout the text).
                      14     14 ;
b000  =               15     15 BIAS	EQU	(MSIZE-20)*1024
e400  =               16     16 CCP	EQU	3400H+BIAS	;base of ccp
ec06  =               17     17 BDOS	EQU	CCP+806H	;base of bdos
fa00  =               18     18 BIOS	EQU	CCP+1600H	;base of bios
002c  =               19     19 NSECTS	EQU	(BIOS-CCP)/128	;warm start sector count
0004  =               20     20 CDISK	EQU	0004H		;current disk number 0=A,...,15=P
0003  =               21     21 IOBYTE	EQU	0003H		;Intel I/O byte
0040  =               22     22 FDCCMD	EQU	0040H		;FDC command bytes
0000  =               23     23 DDTRK	EQU	0		;offset for track
0001  =               24     24 DDSEC	EQU	1		;offset for sector
0002  =               25     25 DDLDMA	EQU	2		;offset for DMA address low
0003  =               26     26 DDHDMA	EQU	3		;offset for DMA address high
                      27     27 ;
                      28     28 ;	I/O ports
                      29     29 ;
0000  =               30     30 CONSTA	EQU	0		;console status port
0001  =               31     31 CONDAT	EQU	1		;console data port
0004  =               32     32 FDC	EQU	4		;port for the FDC
                      33     33 ;
                      34     34 	ORG	BIOS		;origin of BIOS
                      35     35 ;
                      36     36 ;	jump vector for individual subroutines
                      37     37 ;
fa00  c3 f0 fa        38     38 	JMP	BOOT		;cold boot
fa03  c3 14 fb        39     39 WBE	JMP	WBOOT		;warm start
fa06  c3 82 fb        40     40 	JMP	CONST		;console status
fa09  c3 8d fb        41     41 	JMP	CONIN		;console character in
fa0c  c3 96 fb        42     42 	JMP	CONOUT		;console character out
fa0f  c3 a2 fb        43     43 	JMP	LIST		;list character out
fa12  c3 a3 fb        44     44 	JMP	PUNCH		;punch character out
fa15  c3 a4 fb        45     45 	JMP	READER		;reader character in
fa18  c3 a7 fb        46     46 	JMP	HOME		;move disk head to home position
fa1b  c3 ac fb        47     47 	JMP	SELDSK		;select disk drive
fa1e  c3 cc fb        48     48 	JMP	SETTRK		;set track number
fa21  c3 d1 fb        49     49 	JMP	SETSEC		;set sector number
fa24  c3 d6 fb        50     50 	JMP	SETDMA		;set dma address
fa27  c3 df fb        51     51 	JMP	READ		;read disk sector
fa2a  c3 e7 fb        52     52 	JMP	WRITE		;write disk sector
fa2d  c3 a0 fb        53     53 	JMP	LISTST		;list status
fa30  c3 f4 fb        54     54 	JMP	SECTRAN		;sector translate
                      55     55 ;
                      56     56 ;	data tables
                      57     57 ;
fa33  36 34           58     58 SIGNON	DB	MSIZE / 10 + '0',MSIZE MOD 10 + '0'
fa35  4b 20 43 50     59     59 	DB	'K CP/M 2.2 VERS B01+HD',13,10,0
fa39  2f 4d 20 32     59     60
fa3d  2e 32 20 56     59     61
fa41  45 52 53 20     59     62
fa45  42 30 31 2b     59     63
fa49  48 44 0d 0a     59     64
fa4d  00              59     65
