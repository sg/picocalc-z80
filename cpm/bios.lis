Z80/8080-Macro-Assembler  Release 2.1

LOC   OBJECT CODE   LINE   STMT SOURCE CODE
                       1      1 ;	8080 CBIOS for z80pack machines using SD-FDC
                       2      2 ;
                       3      3 ;	Copyright (C) 2024 by Udo Munk
                       4      4 ;
                       5      5 ;	PicoCalc: added a 4 MB hard disk as drive I:. The controller already
                       6      6 ;	carries a 4 bit drive number and byte wide track and sector, so no
                       7      7 ;	new hardware is needed - drive 8 simply has a different geometry,
                       8      8 ;	256 tracks of 128 sectors, and its own disk parameter block.
                       9      9 ;
                      10     10 ;	PicoCalc: the character devices follow the IOBYTE, with the same
                      11     11 ;	assignments as z80pack's IMSAI BIOS so the Kermit, QTerm and XMODEM
                      12     12 ;	setups from its comms disk work unchanged:
                      13     13 ;
                      14     14 ;	CON:	TTY: CRT: = console		BAT: = RDR: in, LST: out
                      15     15 ;		UC1: = modem
                      16     16 ;	RDR:	TTY: UR2: = console		PTR: = USB-C serial
                      17     17 ;		UR1: = modem
                      18     18 ;	PUN:	TTY: UP2: = console		PTP: = USB-C serial
                      19     19 ;		UP1: = modem
                      20     20 ;	LST:	TTY: CRT: = console		LPT: = none
                      21     21 ;		UL1: = USB-C serial
                      22     22 ;
0040  =               23     23 MSIZE	EQU	64		;CP/M memory size in kilobytes
                      24     24 ;
                      25     25 ;	"bias" is address offset from 3400H for memory systems
                      26     26 ;	than 16K (referred to as "b" throughout the text).
                      27     27 ;
b000  =               28     28 BIAS	EQU	(MSIZE-20)*1024
e400  =               29     29 CCP	EQU	3400H+BIAS	;base of ccp
ec06  =               30     30 BDOS	EQU	CCP+806H	;base of bdos
fa00  =               31     31 BIOS	EQU	CCP+1600H	;base of bios
002c  =               32     32 NSECTS	EQU	(BIOS-CCP)/128	;warm start sector count
0004  =               33     33 CDISK	EQU	0004H		;current disk number 0=A,...,15=P
0003  =               34     34 IOBYTE	EQU	0003H		;Intel I/O byte
0094  =               35     35 INITIO	EQU	10010100B	;CON:=TTY:, RDR:=PTR:, PUN:=PTP:, LST:=LPT:
0040  =               36     36 FDCCMD	EQU	0040H		;FDC command bytes
0000  =               37     37 DDTRK	EQU	0		;offset for track
0001  =               38     38 DDSEC	EQU	1		;offset for sector
0002  =               39     39 DDLDMA	EQU	2		;offset for DMA address low
0003  =               40     40 DDHDMA	EQU	3		;offset for DMA address high
                      41     41 ;
                      42     42 ;	I/O ports
                      43     43 ;
0000  =               44     44 CONSTA	EQU	0		;console status port
0001  =               45     45 CONDAT	EQU	1		;console data port
0004  =               46     46 FDC	EQU	4		;port for the FDC
0022  =               47     47 TTY2	EQU	22H		;SIO-2 port A data, the USB-C serial line
0023  =               48     48 TTY2S	EQU	23H		;SIO-2 port A status
0024  =               49     49 MODEM	EQU	24H		;SIO-2 port B data, the WiFi modem
0025  =               50     50 MODEMS	EQU	25H		;SIO-2 port B status
                      51     51 ;
                      52     52 	ORG	BIOS		;origin of BIOS
                      53     53 ;
                      54     54 ;	jump vector for individual subroutines
                      55     55 ;
fa00  c3 f0 fa        56     56 	JMP	BOOT		;cold boot
fa03  c3 16 fb        57     57 WBE	JMP	WBOOT		;warm start
fa06  c3 99 fb        58     58 	JMP	CONST		;console status
fa09  c3 a5 fb        59     59 	JMP	CONIN		;console character in
fa0c  c3 b1 fb        60     60 	JMP	CONOUT		;console character out
fa0f  c3 c9 fb        61     61 	JMP	LIST		;list character out
fa12  c3 d5 fb        62     62 	JMP	PUNCH		;punch character out
fa15  c3 e1 fb        63     63 	JMP	READER		;reader character in
fa18  c3 55 fc        64     64 	JMP	HOME		;move disk head to home position
fa1b  c3 5a fc        65     65 	JMP	SELDSK		;select disk drive
fa1e  c3 7a fc        66     66 	JMP	SETTRK		;set track number
fa21  c3 7f fc        67     67 	JMP	SETSEC		;set sector number
fa24  c3 84 fc        68     68 	JMP	SETDMA		;set dma address
fa27  c3 8d fc        69     69 	JMP	READ		;read disk sector
fa2a  c3 95 fc        70     70 	JMP	WRITE		;write disk sector
fa2d  c3 bd fb        71     71 	JMP	LISTST		;list status
fa30  c3 a2 fc        72     72 	JMP	SECTRAN		;sector translate
                      73     73 ;
                      74     74 ;	data tables
                      75     75 ;
fa33  36 34           76     76 SIGNON	DB	MSIZE / 10 + '0',MSIZE MOD 10 + '0'
fa35  4b 20 43 50     77     77 	DB	'K CP/M 2.2 VERS B01+HD',13,10,0
fa39  2f 4d 20 32     77     78
fa3d  2e 32 20 56     77     79
fa41  45 52 53 20     77     80
fa45  42 30 31 2b     77     81
fa49  48 44 0d 0a     77     82
fa4d  00              77     83
fa4e  0d 0a 42 4f     78     84 BOOTERR	DB	13,10,'BOOT ERROR',13,10,0
fa52  4f 54 20 45     78     85
fa56  52 52 4f 52     78     86
fa5a  0d 0a 00        78     87
                      79     88 ;
                      80     89 ;	disk parameter header for disk 0
fa5d  ad fa 00 00     81     90 DPBASE	DW	TRANS,0000H
fa61  00 00 00 00     82     91 	DW	0000H,0000H
fa65  b4 fc c7 fa     83     92 	DW	DIRBF,DPBLK
fa69  b0 fd 34 fd     84     93 	DW	CHK00,ALL00
                      85     94 ;	disk parameter header for disk 1
fa6d  ad fa 00 00     86     95 	DW	TRANS,0000H
fa71  00 00 00 00     87     96 	DW	0000H,0000H
fa75  b4 fc c7 fa     88     97 	DW	DIRBF,DPBLK
fa79  c0 fd 53 fd     89     98 	DW	CHK01,ALL01
                      90     99 ;	disk parameter header for disk 2
fa7d  ad fa 00 00     91    100 	DW	TRANS,0000H
fa81  00 00 00 00     92    101 	DW	0000H,0000H
fa85  b4 fc c7 fa     93    102 	DW	DIRBF,DPBLK
fa89  d0 fd 72 fd     94    103 	DW	CHK02,ALL02
                      95    104 ;	disk parameter header for disk 3
fa8d  ad fa 00 00     96    105 	DW	TRANS,0000H
fa91  00 00 00 00     97    106 	DW	0000H,0000H
fa95  b4 fc c7 fa     98    107 	DW	DIRBF,DPBLK
fa99  e0 fd 91 fd     99    108 	DW	CHK03,ALL03
                     100    109 ;
                     101    110 ;	disk parameter header for the hard disk, drive I:
                     102    111 ;	no translate table, and no check vector because the media is fixed
fa9d  00 00 00 00    103    112 DPHHD	DW	0000H,0000H
faa1  00 00 00 00    104    113 	DW	0000H,0000H
faa5  b4 fc d6 fa    105    114 	DW	DIRBF,DPBHD
faa9  00 00 f0 fd    106    115 	DW	0000H,ALLHD
                     107    116 ;
                     108    117 ;	sector translate table for IBM 8" SD disks
faad  01 07 0d 13    109    118 TRANS	DB	1,7,13,19	;sectors 1,2,3,4
fab1  19 05 0b 11    110    119 	DB	25,5,11,17	;sectors 5,6,7,8
fab5  17 03 09 0f    111    120 	DB	23,3,9,15	;sectors 9,10,11,12
fab9  15 02 08 0e    112    121 	DB	21,2,8,14	;sectors 13,14,15,16
fabd  14 1a 06 0c    113    122 	DB	20,26,6,12	;sectors 17,18,19,20
fac1  12 18 04 0a    114    123 	DB	18,24,4,10	;sectors 21,22,23,24
fac5  10 16          115    124 	DB	16,22		;sectors 25,26
                     116    125 ;
                     117    126 ;	disk parameter block for IBM 8" SD disks
fac7  1a 00          118    127 DPBLK	DW	26		;sectors per track
fac9  03             119    128 	DB	3		;block shift factor
faca  07             120    129 	DB	7		;block mask
facb  00             121    130 	DB	0		;extent mask
facc  f2 00          122    131 	DW	242		;disk size-1
face  3f 00          123    132 	DW	63		;directory max
fad0  c0             124    133 	DB	192		;alloc 0
fad1  00             125    134 	DB	0		;alloc 1
fad2  10 00          126    135 	DW	16		;check size
fad4  02 00          127    136 	DW	2		;track offset
                     128    137 ;
                     129    138 ;	disk parameter block for the 4 MB hard disk
                     130    139 ;	2048 byte blocks, 2048 of them, 512 directory entries
fad6  80 00          131    140 DPBHD	DW	128		;sectors per track
fad8  04             132    141 	DB	4		;block shift factor
fad9  0f             133    142 	DB	15		;block mask
fada  00             134    143 	DB	0		;extent mask
fadb  ff 07          135    144 	DW	2047		;disk size-1
fadd  ff 01          136    145 	DW	511		;directory max
fadf  ff             137    146 	DB	255		;alloc 0, 8 blocks of directory
fae0  00             138    147 	DB	0		;alloc 1
fae1  00 00          139    148 	DW	0		;check size, 0 for fixed media
fae3  00 00          140    149 	DW	0		;track offset
                     141    150 ;
                     142    151 ;	print a message to the console
                     143    152 ;	pointer to string in hl
                     144    153 ;
fae5  7e             145    154 PRTMSG	MOV	A,M		;get next message byte
fae6  b7             146    155 	ORA	A		;is it zero?
fae7  c8             147    156 	RZ			;yes, done
fae8  4f             148    157 	MOV	C,A		;no, print character on console
fae9  cd b1 fb       149    158 	CALL	CONOUT
faec  23             150    159 	INX	H		;and do next
faed  c3 e5 fa       151    160 	JMP	PRTMSG
                     152    161 ;
                     153    162 ;	cold start
                     154    163 ;
faf0  31 80 00       155    164 BOOT	LXI	SP,80H		;use space below buffer for stack
faf3  21 33 fa       156    165 	LXI	H,SIGNON	;print signon
faf6  cd e5 fa       157    166 	CALL	PRTMSG
faf9  af             158    167 	XRA	A		;zero in the accumulator
fafa  32 04 00       159    168 	STA	CDISK		;select disk drive 0
fafd  32 b3 fc       160    169 	STA	DSKNO
fb00  3e 94          161    170 	MVI	A,INITIO	;setup IOBYTE
fb02  32 03 00       162    171 	STA	IOBYTE
fb05  3e 10          163    172 	MVI	A,10H		;setup FDC command
fb07  d3 04          164    173 	OUT	FDC
fb09  3e 40          165    174 	MVI	A,FDCCMD AND 0FFH
fb0b  d3 04          166    175 	OUT	FDC
fb0d  3e 00          167    176 	MVI	A,FDCCMD SHR 8
fb0f  d3 04          168    177 	OUT	FDC
fb11  37             169    178 	STC			;flag for cold start
fb12  3f             170    179 	CMC
fb13  c3 60 fb       171    180 	JMP	GOCPM		;initialize and go to CP/M
                     172    181 ;
                     173    182 ;	warm start
                     174    183 ;
fb16  31 80 00       175    184 WBOOT	LXI	SP,80H		;use space below buffer for stack
fb19  0e 00          176    185 	MVI	C,0		;select disk 0
fb1b  cd 5a fc       177    186 	CALL	SELDSK
fb1e  cd 55 fc       178    187 	CALL	HOME		;go to track 0
fb21  06 2c          179    188 	MVI	B,NSECTS	;B counts # of sectors to load
fb23  0e 00          180    189 	MVI	C,0		;C has the current track #
fb25  16 02          181    190 	MVI	D,2		;D has the next sector to load
fb27  21 00 e4       182    191 	LXI	H,CCP		;base of CP/M
fb2a  c5             183    192 LOAD1	PUSH	B		;save sector count and current track
fb2b  d5             184    193 	PUSH	D		;save next sector to read
fb2c  e5             185    194 	PUSH	H		;save DMA address
fb2d  4a             186    195 	MOV	C,D		;get sector address to C
fb2e  cd 7f fc       187    196 	CALL	SETSEC		;set sector address
fb31  c1             188    197 	POP	B		;recall DMA address to BC
fb32  c5             189    198 	PUSH	B		;and replace on stack for later recall
fb33  cd 84 fc       190    199 	CALL	SETDMA		;set DMA address from BC
fb36  cd 8d fc       191    200 	CALL	READ		;read sector
fb39  b7             192    201 	ORA	A		;any errors?
fb3a  ca 44 fb       193    202 	JZ	LOAD2		;no, continue
fb3d  21 4e fa       194    203 	LXI	H,BOOTERR	;otherwise print message
fb40  cd e5 fa       195    204 	CALL	PRTMSG
fb43  76             196    205 	HLT			;and halt the machine
fb44  e1             197    206 LOAD2	POP	H		;recall DMA address
fb45  11 80 00       198    207 	LXI	D,128		;DMA = DMA + 128
fb48  19             199    208 	DAD	D		;next DMA address now in HL
fb49  d1             200    209 	POP	D		;recall sector address
fb4a  c1             201    210 	POP	B		;recall # of sectors remaining
fb4b  05             202    211 	DCR	B		;sectors = sectors - 1
fb4c  37             203    212 	STC			;flag for warm start
fb4d  ca 60 fb       204    213 	JZ	GOCPM		;transfer to CP/M if all loaded
fb50  14             205    214 	INR	D		;next sector
fb51  7a             206    215 	MOV	A,D		;sector = 27 ?
fb52  fe 1b          207    216 	CPI	27
fb54  da 2a fb       208    217 	JC	LOAD1		;no, continue
fb57  16 01          209    218 	MVI	D,1		;else begin with sector 1 on next track
fb59  0c             210    219 	INR	C
fb5a  cd 7a fc       211    220 	CALL	SETTRK
fb5d  c3 2a fb       212    221 	JMP	LOAD1		;for another sector
fb60  3e c3          213    222 GOCPM	MVI	A,0C3H		;C3 is a JMP instruction
fb62  32 00 00       214    223 	STA	0		;for jmp to wboot
fb65  21 03 fa       215    224 	LXI	H,WBE		;WBOOT entry point
fb68  22 01 00       216    225 	SHLD	1		;set address for JMP at 0
fb6b  32 05 00       217    226 	STA	5		;for JMP to BDOS
fb6e  21 06 ec       218    227 	LXI	H,BDOS		;BDOS entry point
fb71  22 06 00       219    228 	SHLD	6		;set address for JMP at 5
fb74  01 80 00       220    229 	LXI	B,80H		;default dma address is 80H
fb77  cd 84 fc       221    230 	CALL	SETDMA
fb7a  3a 04 00       222    231 	LDA	CDISK		;get current disk number
fb7d  4f             223    232 	MOV	C,A		;send to the CCP
fb7e  da 03 e4       224    233 	JC	CCP+3		;go to CCP warm start
fb81  c3 00 e4       225    234 	JMP	CCP		;go to CCP cold start
                     226    235 ;
                     227    236 ;	jump to one of the four addresses after the call, picked by the
                     228    237 ;	two IOBYTE bits that the shift count byte in front of them selects
                     229    238 ;
fb84  e3             230    239 DISPATCH XTHL			;save callers HL, get table address
fb85  56             231    240 	MOV	D,M		;get shift count into D
fb86  23             232    241 	INX	H		;point to table
fb87  3a 03 00       233    242 	LDA	IOBYTE
fb8a  07             234    243 DSHIFT	RLC			;shift the field into bits 2-1
fb8b  15             235    244 	DCR	D
fb8c  c2 8a fb       236    245 	JNZ	DSHIFT
fb8f  e6 06          237    246 	ANI	06H
fb91  5f             238    247 	MOV	E,A		;D is already clear
fb92  19             239    248 	DAD	D
fb93  7e             240    249 	MOV	A,M		;get table word into HL
fb94  23             241    250 	INX	H
fb95  66             242    251 	MOV	H,M
fb96  6f             243    252 	MOV	L,A
fb97  e3             244    253 	XTHL			;put routine address, get callers HL
fb98  c9             245    254 	RET			;go to routine
                     246    255 ;
                     247    256 ;	console status, return 0FFH if character ready, 00H if not
                     248    257 ;
fb99  cd 84 fb       249    258 CONST	CALL	DISPATCH
fb9c  01             250    259 	DB	1		;bits 1-0
fb9d  ed fb          251    260 	DW	TTYIS		;TTY:
fb9f  ed fb          252    261 	DW	TTYIS		;CRT:
fba1  15 fc          253    262 	DW	TTY2IS		;BAT:
fba3  39 fc          254    263 	DW	MODIS		;UC1:
                     255    264 ;
                     256    265 ;	console input character into register A
                     257    266 ;
fba5  cd 84 fb       258    267 CONIN	CALL	DISPATCH
fba8  01             259    268 	DB	1		;bits 1-0
fba9  01 fc          260    269 	DW	TTYIN		;TTY:
fbab  01 fc          261    270 	DW	TTYIN		;CRT:
fbad  25 fc          262    271 	DW	TTY2IN		;BAT:
fbaf  41 fc          263    272 	DW	MODIN		;UC1:
                     264    273 ;
                     265    274 ;	console output character from register C
                     266    275 ;
fbb1  cd 84 fb       267    276 CONOUT	CALL	DISPATCH
fbb4  01             268    277 	DB	1		;bits 1-0
fbb5  0a fc          269    278 	DW	TTYOUT		;TTY:
fbb7  0a fc          270    279 	DW	TTYOUT		;CRT:
fbb9  14 fc          271    280 	DW	LPTOUT		;BAT:
fbbb  4b fc          272    281 	DW	MODOUT		;UC1:
                     273    282 ;
                     274    283 ;	printer status, return 0FFH if ready, 00H if not
                     275    284 ;
fbbd  cd 84 fb       276    285 LISTST	CALL	DISPATCH
fbc0  03             277    286 	DB	3		;bits 7-6
fbc1  f8 fb          278    287 	DW	TTYOS		;TTY:
fbc3  f8 fb          279    288 	DW	TTYOS		;CRT:
fbc5  f6 fb          280    289 	DW	NOTRDY		;LPT:
fbc7  1d fc          281    290 	DW	TTY2OS		;UL1:
                     282    291 ;
                     283    292 ;	list character from register C
                     284    293 ;
fbc9  cd 84 fb       285    294 LIST	CALL	DISPATCH
fbcc  03             286    295 	DB	3		;bits 7-6
fbcd  0a fc          287    296 	DW	TTYOUT		;TTY:
fbcf  0a fc          288    297 	DW	TTYOUT		;CRT:
fbd1  14 fc          289    298 	DW	LPTOUT		;LPT:
fbd3  2f fc          290    299 	DW	TTY2OUT		;UL1:
                     291    300 ;
                     292    301 ;	punch character from register C
                     293    302 ;
fbd5  cd 84 fb       294    303 PUNCH	CALL	DISPATCH
fbd8  05             295    304 	DB	5		;bits 5-4
fbd9  0a fc          296    305 	DW	TTYOUT		;TTY:
fbdb  2f fc          297    306 	DW	TTY2OUT		;PTP:
fbdd  4b fc          298    307 	DW	MODOUT		;UP1:
fbdf  0a fc          299    308 	DW	TTYOUT		;UP2:
                     300    309 ;
                     301    310 ;	read character into register A from reader
                     302    311 ;
fbe1  cd 84 fb       303    312 READER	CALL	DISPATCH
fbe4  07             304    313 	DB	7		;bits 3-2
fbe5  01 fc          305    314 	DW	TTYIN		;TTY:
fbe7  25 fc          306    315 	DW	TTY2IN		;PTR:
fbe9  41 fc          307    316 	DW	MODIN		;UR1:
fbeb  01 fc          308    317 	DW	TTYIN		;UR2:
                     309    318 ;
                     310    319 ;	console, the screen and keyboard (status bits are active low)
                     311    320 ;
fbed  db 00          312    321 TTYIS	IN	CONSTA
fbef  0f             313    322 	RRC			;test bit 0
fbf0  da f6 fb       314    323 	JC	NOTRDY
fbf3  3e ff          315    324 DEVRDY	MVI	A,0FFH
fbf5  c9             316    325 	RET
fbf6  af             317    326 NOTRDY	XRA	A
fbf7  c9             318    327 	RET
                     319    328 ;
fbf8  db 00          320    329 TTYOS	IN	CONSTA
fbfa  07             321    330 	RLC			;test bit 7
fbfb  da f6 fb       322    331 	JC	NOTRDY
fbfe  c3 f3 fb       323    332 	JMP	DEVRDY
                     324    333 ;
fc01  db 00          325    334 TTYIN	IN	CONSTA
fc03  0f             326    335 	RRC			;test bit 0
fc04  da 01 fc       327    336 	JC	TTYIN		;not ready
fc07  db 01          328    337 	IN	CONDAT
fc09  c9             329    338 	RET
                     330    339 ;
fc0a  db 00          331    340 TTYOUT	IN	CONSTA
fc0c  07             332    341 	RLC			;test bit 7
fc0d  da 0a fc       333    342 	JC	TTYOUT		;wait until transmitter ready
fc10  79             334    343 	MOV	A,C
fc11  d3 01          335    344 	OUT	CONDAT
fc13  c9             336    345 	RET
                     337    346 ;
                     338    347 ;	there is no printer, so output to it is thrown away
                     339    348 ;
fc14  c9             340    349 LPTOUT	RET
                     341    350 ;
                     342    351 ;	SIO-2 port A, the USB-C serial line (8251 status bits)
                     343    352 ;
fc15  db 23          344    353 TTY2IS	IN	TTY2S
fc17  e6 02          345    354 	ANI	02H		;receiver ready?
fc19  c8             346    355 	RZ
fc1a  c3 f3 fb       347    356 	JMP	DEVRDY
                     348    357 ;
fc1d  db 23          349    358 TTY2OS	IN	TTY2S
fc1f  e6 01          350    359 	ANI	01H		;transmitter ready?
fc21  c8             351    360 	RZ
fc22  c3 f3 fb       352    361 	JMP	DEVRDY
                     353    362 ;
fc25  db 23          354    363 TTY2IN	IN	TTY2S
fc27  e6 02          355    364 	ANI	02H
fc29  ca 25 fc       356    365 	JZ	TTY2IN		;wait until character available
fc2c  db 22          357    366 	IN	TTY2
fc2e  c9             358    367 	RET
                     359    368 ;
fc2f  db 23          360    369 TTY2OUT	IN	TTY2S
fc31  0f             361    370 	RRC
fc32  d2 2f fc       362    371 	JNC	TTY2OUT		;wait until transmitter ready
fc35  79             363    372 	MOV	A,C
fc36  d3 22          364    373 	OUT	TTY2
fc38  c9             365    374 	RET
                     366    375 ;
                     367    376 ;	SIO-2 port B, the WiFi modem (8251 status bits)
                     368    377 ;
fc39  db 25          369    378 MODIS	IN	MODEMS
fc3b  e6 02          370    379 	ANI	02H		;receiver ready?
fc3d  c8             371    380 	RZ
fc3e  c3 f3 fb       372    381 	JMP	DEVRDY
                     373    382 ;
fc41  db 25          374    383 MODIN	IN	MODEMS
fc43  e6 02          375    384 	ANI	02H
fc45  ca 41 fc       376    385 	JZ	MODIN		;wait until character available
fc48  db 24          377    386 	IN	MODEM
fc4a  c9             378    387 	RET
                     379    388 ;
