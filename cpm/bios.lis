fa61  00 00 00 00     64     73 	DW	0000H,0000H
fa65  06 fc c7 fa     65     74 	DW	DIRBF,DPBLK
fa69  02 fd 86 fc     66     75 	DW	CHK00,ALL00
                      67     76 ;	disk parameter header for disk 1
fa6d  ad fa 00 00     68     77 	DW	TRANS,0000H
fa71  00 00 00 00     69     78 	DW	0000H,0000H
fa75  06 fc c7 fa     70     79 	DW	DIRBF,DPBLK
fa79  12 fd a5 fc     71     80 	DW	CHK01,ALL01
                      72     81 ;	disk parameter header for disk 2
fa7d  ad fa 00 00     73     82 	DW	TRANS,0000H
fa81  00 00 00 00     74     83 	DW	0000H,0000H
fa85  06 fc c7 fa     75     84 	DW	DIRBF,DPBLK
fa89  22 fd c4 fc     76     85 	DW	CHK02,ALL02
                      77     86 ;	disk parameter header for disk 3
fa8d  ad fa 00 00     78     87 	DW	TRANS,0000H
fa91  00 00 00 00     79     88 	DW	0000H,0000H
